<Page
    x:Class="PotomacAnalyst.Views.Auth.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0A0A0B">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════
             MAIN SPLIT  (Left branding | Right form)
             ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="460"/>
            </Grid.ColumnDefinitions>

            <!-- ────────────────────────────────────────────
                 LEFT  –  Branding panel
                 ──────────────────────────────────────────── -->
            <Grid Grid.Column="0">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A1A1D" Offset="0"/>
                        <GradientStop Color="#0A0A0B" Offset="0.5"/>
                        <GradientStop Color="#1A1A1D" Offset="1"/>
                    </LinearGradientBrush>
                </Grid.Background>

                <!-- Yellow radial glow – left/centre -->
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.2,0.5" GradientOrigin="0.2,0.5"
                                             RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#1AFEC00F" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Yellow radial glow – bottom/right -->
                <Rectangle>
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.8,0.8" GradientOrigin="0.8,0.8"
                                             RadiusX="0.4" RadiusY="0.4">
                            <GradientStop Color="#0DFEC00F" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Centred branding content -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="500"
                            Spacing="0">

                    <!-- Icon -->
                    <Border Width="100" Height="100"
                            CornerRadius="24"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,32">
                        <Image Source="ms-appx:///Assets/potomac-icon.png"
                               Stretch="Uniform"/>
                    </Border>

                    <!-- ANALYST -->
                    <TextBlock Text="ANALYST"
                               FontFamily="{StaticResource RajdhaniBold}"
                               FontSize="48"
                               FontWeight="Bold"
                               Foreground="White"
                               CharacterSpacing="83"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,8"/>

                    <!-- BY POTOMAC -->
                    <TextBlock Text="BY POTOMAC"
                               FontFamily="{StaticResource RajdhaniMedium}"
                               FontSize="16"
                               Foreground="#FEC00F"
                               CharacterSpacing="500"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,48"/>

                    <!-- Top decorative line -->
                    <Rectangle Height="2" Width="60" HorizontalAlignment="Center">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FFFEC00F" Offset="0.5"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                    <!-- BREAK THE STATUS QUO – side-to-side sweep glow -->
                    <Grid x:Name="GlowTextGrid"
                          Margin="0,20,0,20"
                          HorizontalAlignment="Center">

                        <Grid.Resources>
                            <Storyboard x:Name="GlowPulse" RepeatBehavior="Forever">

                                <!-- Layer 1 sweep (X is the correct WinUI3 property) -->
                                <DoubleAnimation Storyboard.TargetName="GlowLayer1Transform"
                                                 Storyboard.TargetProperty="X"
                                                 From="-12" To="12"
                                                 Duration="0:0:2.2"
                                                 AutoReverse="True">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="GlowLayer1"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0.45" To="0.9"
                                                 Duration="0:0:2.2"
                                                 AutoReverse="True">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>

                                <!-- Layer 2 sweep -->
                                <DoubleAnimation Storyboard.TargetName="GlowLayer2Transform"
                                                 Storyboard.TargetProperty="X"
                                                 From="-20" To="20"
                                                 Duration="0:0:2.2"
                                                 AutoReverse="True">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="GlowLayer2"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0.08" To="0.7"
                                                 Duration="0:0:2.2"
                                                 AutoReverse="True">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>

                                <!-- Layer 3 sweep — widest travel -->
                                <DoubleAnimation Storyboard.TargetName="GlowLayer3Transform"
                                                 Storyboard.TargetProperty="X"
                                                 From="-30" To="30"
                                                 Duration="0:0:2.2"
                                                 AutoReverse="True">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="GlowLayer3"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0.0" To="0.45"
                                                 Duration="0:0:2.2"
                                                 AutoReverse="True">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>

                            </Storyboard>
                        </Grid.Resources>

                        <!-- Outer bloom — widest travel, tallest scale -->
                        <TextBlock x:Name="GlowLayer3"
                                   Text="BREAK THE STATUS QUO"
                                   FontFamily="{StaticResource RajdhaniBold}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#FEC00F"
                                   Opacity="0.0"
                                   CharacterSpacing="214"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1.08" ScaleY="1.9"/>
                                    <TranslateTransform x:Name="GlowLayer3Transform" X="-30"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <!-- Mid halo -->
                        <TextBlock x:Name="GlowLayer2"
                                   Text="BREAK THE STATUS QUO"
                                   FontFamily="{StaticResource RajdhaniBold}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#FEC00F"
                                   Opacity="0.08"
                                   CharacterSpacing="214"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1.04" ScaleY="1.4"/>
                                    <TranslateTransform x:Name="GlowLayer2Transform" X="-20"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <!-- Tight inner glow -->
                        <TextBlock x:Name="GlowLayer1"
                                   Text="BREAK THE STATUS QUO"
                                   FontFamily="{StaticResource RajdhaniBold}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#FEC00F"
                                   Opacity="0.45"
                                   CharacterSpacing="214"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="1.015" ScaleY="1.12"/>
                                    <TranslateTransform x:Name="GlowLayer1Transform" X="-12"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <!-- Sharp top layer — static, always crisp -->
                        <TextBlock Text="BREAK THE STATUS QUO"
                                   FontFamily="{StaticResource RajdhaniBold}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#FEC00F"
                                   CharacterSpacing="214"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Bottom decorative line -->
                    <Rectangle Height="2" Width="60" HorizontalAlignment="Center">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#FFFEC00F" Offset="0.5"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>

                </StackPanel>
            </Grid>

            <!-- ────────────────────────────────────────────
                 RIGHT  –  Login form panel
                 ──────────────────────────────────────────── -->
            <Grid Grid.Column="1" Background="#121212">

                <!-- Left border accent -->
                <Rectangle Width="1" HorizontalAlignment="Left" Fill="#2A2A2A"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="1"
                                Width="340"
                                HorizontalAlignment="Center"
                                Spacing="0">

                        <!-- WELCOME BACK -->
                        <TextBlock Text="WELCOME BACK"
                                   FontFamily="{StaticResource RajdhaniBold}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   CharacterSpacing="71"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Sign in to continue to your dashboard"
                                   FontFamily="{StaticResource QuicksandRegular}"
                                   FontSize="14"
                                   Foreground="#757575"
                                   Margin="0,0,0,40"/>

                        <!-- Error Banner -->
                        <Border x:Name="ErrorBanner"
                                Background="#2D0A0A"
                                BorderBrush="#CF3030"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10"
                                Margin="0,0,0,20"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="&#x26A0;"
                                           FontSize="14"
                                           Foreground="#CF3030"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="ErrorText"
                                           FontFamily="{StaticResource QuicksandRegular}"
                                           FontSize="13"
                                           Foreground="#CF3030"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- EMAIL ADDRESS label -->
                        <TextBlock Text="EMAIL ADDRESS"
                                   FontFamily="{StaticResource RajdhaniMedium}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#AAAAAA"
                                   CharacterSpacing="83"
                                   Margin="0,0,0,8"/>

                        <!-- FIX: Removed fixed Height, use Padding to naturally size and center text -->
                        <TextBox x:Name="EmailBox"
                                 PlaceholderText="you@example.com"
                                 InputScope="EmailSmtpAddress"
                                 Padding="14,15,14,15"
                                 CornerRadius="10"
                                 FontFamily="{StaticResource QuicksandRegular}"
                                 FontSize="15"
                                 Margin="0,0,0,24"
                                 KeyDown="Input_KeyDown">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground"                      Color="#1E1E1E"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused"                Color="#1E1E1E"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver"            Color="#252525"/>
                                <SolidColorBrush x:Key="TextControlBorderBrush"                      Color="#2A2A2A"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused"               Color="#FEC00F"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"           Color="#3A3A3A"/>
                                <SolidColorBrush x:Key="TextControlForeground"                       Color="White"/>
                                <SolidColorBrush x:Key="TextControlForegroundFocused"                Color="White"/>
                                <SolidColorBrush x:Key="TextControlPlaceholderForeground"            Color="#555555"/>
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused"     Color="#555555"/>
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#555555"/>
                                <SolidColorBrush x:Key="TextControlSelectionHighlightColor"          Color="#33FEC00F"/>
                            </TextBox.Resources>
                        </TextBox>

                        <!-- PASSWORD label + Forgot password -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="PASSWORD"
                                       FontFamily="{StaticResource RajdhaniMedium}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#AAAAAA"
                                       CharacterSpacing="83"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="ForgotBtn"
                                    Content="Forgot password?"
                                    FontFamily="{StaticResource QuicksandMedium}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#FEC00F"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Click="ForgotBtn_Click">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground"            Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#FFD84D"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPressed"       Color="#E6AC00"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed"      Color="Transparent"/>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- FIX: Same padding approach as EmailBox so both inputs are identical height -->
                        <PasswordBox x:Name="PasswordBox"
                                     PlaceholderText="Enter your password"
                                     Padding="14,15,14,15"
                                     CornerRadius="10"
                                     FontFamily="{StaticResource QuicksandRegular}"
                                     FontSize="15"
                                     PasswordRevealMode="Peek"
                                     Margin="0,0,0,28"
                                     KeyDown="Input_KeyDown">
                            <PasswordBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground"                      Color="#1E1E1E"/>
                                <SolidColorBrush x:Key="TextControlBackgroundFocused"                Color="#1E1E1E"/>
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver"            Color="#252525"/>
                                <SolidColorBrush x:Key="TextControlBorderBrush"                      Color="#2A2A2A"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused"               Color="#FEC00F"/>
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"           Color="#3A3A3A"/>
                                <SolidColorBrush x:Key="TextControlForeground"                       Color="White"/>
                                <SolidColorBrush x:Key="TextControlForegroundFocused"                Color="White"/>
                                <SolidColorBrush x:Key="TextControlPlaceholderForeground"            Color="#555555"/>
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused"     Color="#555555"/>
                                <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#555555"/>
                            </PasswordBox.Resources>
                        </PasswordBox>

                        <!-- SIGN IN button -->
                        <Button x:Name="SignInBtn"
                                HorizontalAlignment="Stretch"
                                Height="52"
                                CornerRadius="10"
                                BorderThickness="0"
                                Click="SignInBtn_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground"            Color="#FEC00F"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFD040"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#E6AC00"/>
                                <SolidColorBrush x:Key="ButtonForeground"            Color="#0A0A0B"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#0A0A0B"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed"       Color="#0A0A0B"/>
                                <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"      Color="Transparent"/>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Spacing="10">
                                <TextBlock Text="&#xE8A5;"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="16"
                                           Foreground="#0A0A0B"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="SIGN IN"
                                           FontFamily="{StaticResource RajdhaniBold}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#0A0A0B"
                                           CharacterSpacing="71"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Loading bar -->
                        <ProgressBar x:Name="LoadingBar"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed"
                                     Foreground="#FEC00F"
                                     Background="#2A2A2A"
                                     Height="3"
                                     Margin="0,8,0,0"/>

                        <!-- OR divider -->
                        <Grid Margin="0,32,0,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Height="1"
                                       VerticalAlignment="Center" Fill="#2A2A2A"/>
                            <TextBlock Grid.Column="1" Text="OR"
                                       FontFamily="{StaticResource QuicksandRegular}"
                                       FontSize="12" Foreground="#555555"
                                       Margin="16,0" VerticalAlignment="Center"/>
                            <Rectangle Grid.Column="2" Height="1"
                                       VerticalAlignment="Center" Fill="#2A2A2A"/>
                        </Grid>

                        <!-- Don't have an account -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="4">
                            <TextBlock Text="Don't have an account?"
                                       FontFamily="{StaticResource QuicksandRegular}"
                                       FontSize="14"
                                       Foreground="#9E9E9E"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="RegisterBtn"
                                    Content="Create one"
                                    FontFamily="{StaticResource QuicksandMedium}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#FEC00F"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Click="RegisterBtn_Click">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground"            Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#FFD84D"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPressed"       Color="#E6AC00"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed"      Color="Transparent"/>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════
             FOOTER
             ═══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="#0A0A0B"
                BorderBrush="#2A2A2A"
                BorderThickness="0,1,0,0"
                Padding="0,12">
            <TextBlock Text="© 2026 Potomac Fund Management. All rights reserved."
                       FontFamily="{StaticResource QuicksandRegular}"
                       FontSize="12"
                       Foreground="#555555"
                       HorizontalAlignment="Center"/>
        </Border>

    </Grid>
</Page>
