<Page
    x:Class="PotomacAnalyst.Views.Auth.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <StackPanel Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="0"
                    Padding="0,48,0,48">

            <!-- Logo -->
            <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,36">
                <Border Width="56" Height="56"
                        CornerRadius="12"
                        Background="{StaticResource PotomacYellowBrush}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="P"
                               FontFamily="{StaticResource RajdhaniBold}"
                               FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource PotomacDarkGrayBrush}"/>
                </Border>
                <TextBlock Text="POTOMAC ANALYST"
                           FontFamily="{StaticResource RajdhaniBold}"
                           FontSize="22" FontWeight="Bold"
                           CharacterSpacing="80"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <!-- Card -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="24">

                    <!-- Header -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="RESET PASSWORD"
                                   Style="{StaticResource H2Style}"/>
                        <TextBlock Text="Enter your email address and we will send you a link to reset your password."
                                   Style="{StaticResource BodyStyle}"/>
                    </StackPanel>

                    <!-- Error banner -->
                    <Border x:Name="ErrorBanner"
                            Background="#2D1515"
                            BorderBrush="{StaticResource PotomacPinkBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText"
                                   FontFamily="{StaticResource QuicksandRegular}"
                                   FontSize="13"
                                   Foreground="{StaticResource PotomacPinkBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Success banner -->
                    <Border x:Name="SuccessBanner"
                            Background="#0D2D1A"
                            BorderBrush="{StaticResource PotomacTurquoiseBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10"
                            Visibility="Collapsed">
                        <TextBlock x:Name="SuccessText"
                                   FontFamily="{StaticResource QuicksandRegular}"
                                   FontSize="13"
                                   Foreground="{StaticResource PotomacTurquoiseBrush}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Email -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="EMAIL ADDRESS"
                                   Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="EmailBox"
                                 Style="{StaticResource InputStyle}"
                                 PlaceholderText="you@example.com"
                                 InputScope="EmailSmtpAddress"/>
                    </StackPanel>

                    <!-- Submit button -->
                    <Button x:Name="ResetBtn"
                            Content="SEND RESET LINK"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="ResetBtn_Click"/>

                    <!-- Progress -->
                    <ProgressBar x:Name="LoadingBar"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 Foreground="{StaticResource PotomacYellowBrush}"
                                 Background="{StaticResource BorderBrush}"
                                 Height="3"/>

                    <!-- Divider -->
                    <Border Style="{StaticResource DividerStyle}"/>

                    <!-- Back to login -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="6">
                        <TextBlock Text="Remember your password?"
                                   Style="{StaticResource BodyStyle}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BackBtn"
                                Content="Sign in"
                                FontFamily="{StaticResource QuicksandMedium}"
                                FontSize="14"
                                Foreground="{StaticResource PotomacYellowBrush}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Click="BackBtn_Click"/>
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Page>
