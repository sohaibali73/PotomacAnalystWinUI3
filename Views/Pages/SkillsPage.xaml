<Page
    x:Class="PotomacAnalyst.Views.Pages.SkillsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="48,32,48,24"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Spacing="6">
                    <TextBlock Text="AI SKILLS" Style="{StaticResource H2Style}"/>
                    <TextBlock Text="Enable and configure specialized AI capabilities for your workspace"
                               Style="{StaticResource BodyStyle}"/>
                </StackPanel>
                <!-- Search -->
                <Border HorizontalAlignment="Right" Width="280"
                        Background="{StaticResource InputBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE721;"
                                  FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                  HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox"
                                 FontFamily="{StaticResource QuicksandRegular}" FontSize="13"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 PlaceholderText="Search skills..."
                                 Padding="36,10,12,10"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="48,32,48,48" Spacing="36">

                <!-- Category filter -->
                <StackPanel Spacing="12">
                    <TextBlock Text="CATEGORIES" Style="{StaticResource LabelStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CatAll"     Content="ALL"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="16,8" FontSize="12" Click="Category_Click" Tag="all"/>
                        <Button Content="RESEARCH"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="16,8" FontSize="12" Click="Category_Click" Tag="research"/>
                        <Button Content="TRADING"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="16,8" FontSize="12" Click="Category_Click" Tag="trading"/>
                        <Button Content="CONTENT"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="16,8" FontSize="12" Click="Category_Click" Tag="content"/>
                        <Button Content="ANALYSIS"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="16,8" FontSize="12" Click="Category_Click" Tag="analysis"/>
                    </StackPanel>
                </StackPanel>

                <!-- Skills grid -->
                <StackPanel Spacing="16">
                    <TextBlock Text="AVAILABLE SKILLS" Style="{StaticResource H3Style}"/>

                    <Grid ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Market Research -->
                        <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource CardSmallStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Border Width="44" Height="44" CornerRadius="10" Background="#2A2000"
                                            HorizontalAlignment="Left">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE721;"
                                                  FontSize="20" Foreground="{StaticResource PotomacYellowBrush}"/>
                                    </Border>
                                    <ToggleSwitch x:Name="SkillMarketResearch"
                                                  HorizontalAlignment="Right" Margin="0"
                                                  IsOn="True"/>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="MARKET RESEARCH" Style="{StaticResource H5Style}"/>
                                    <Border Style="{StaticResource BadgeStyle}" HorizontalAlignment="Left">
                                        <TextBlock Text="RESEARCH" Style="{StaticResource TagStyle}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Web search and real-time market data retrieval for stocks, ETFs, and market news."
                                           Style="{StaticResource BodyStyle}" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <!-- AFL Generator -->
                        <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource CardSmallStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Border Width="44" Height="44" CornerRadius="10" Background="#2A2000"
                                            HorizontalAlignment="Left">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE943;"
                                                  FontSize="20" Foreground="{StaticResource PotomacYellowBrush}"/>
                                    </Border>
                                    <ToggleSwitch HorizontalAlignment="Right" Margin="0" IsOn="True"/>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="AFL CODE GENERATOR" Style="{StaticResource H5Style}"/>
                                    <Border Style="{StaticResource BadgeStyle}" HorizontalAlignment="Left">
                                        <TextBlock Text="TRADING" Style="{StaticResource TagStyle}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Generate, validate, and optimize AmiBroker Formula Language code for trading strategies."
                                           Style="{StaticResource BodyStyle}" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <!-- Chart Analysis -->
                        <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource CardSmallStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Border Width="44" Height="44" CornerRadius="10" Background="#001A2A"
                                            HorizontalAlignment="Left">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9F5;"
                                                  FontSize="20" Foreground="{StaticResource PotomacTurquoiseBrush}"/>
                                    </Border>
                                    <ToggleSwitch HorizontalAlignment="Right" Margin="0" IsOn="True"/>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="CHART ANALYSIS" Style="{StaticResource H5Style}"/>
                                    <Border Style="{StaticResource BadgeStyle}" HorizontalAlignment="Left">
                                        <TextBlock Text="ANALYSIS" Style="{StaticResource TagStyle}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Analyze chart patterns, technical indicators, and generate trading insights from visual data."
                                           Style="{StaticResource BodyStyle}" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <!-- Content Writer -->
                        <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource CardSmallStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Border Width="44" Height="44" CornerRadius="10" Background="#1A1A2A"
                                            HorizontalAlignment="Left">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;"
                                                  FontSize="20" Foreground="#7B68EE"/>
                                    </Border>
                                    <ToggleSwitch HorizontalAlignment="Right" Margin="0" IsOn="False"/>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="CONTENT WRITER" Style="{StaticResource H5Style}"/>
                                    <Border Style="{StaticResource BadgeStyle}" HorizontalAlignment="Left">
                                        <TextBlock Text="CONTENT" Style="{StaticResource TagStyle}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Generate professional financial content including market commentaries, research reports, and client newsletters."
                                           Style="{StaticResource BodyStyle}" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <!-- Backtest Analyzer -->
                        <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource CardSmallStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Border Width="44" Height="44" CornerRadius="10" Background="#002A1A"
                                            HorizontalAlignment="Left">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9F5;"
                                                  FontSize="20" Foreground="#4CAF50"/>
                                    </Border>
                                    <ToggleSwitch HorizontalAlignment="Right" Margin="0" IsOn="True"/>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="BACKTEST ANALYZER" Style="{StaticResource H5Style}"/>
                                    <Border Style="{StaticResource BadgeStyle}" HorizontalAlignment="Left">
                                        <TextBlock Text="ANALYSIS" Style="{StaticResource TagStyle}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Deep analysis of backtest results with AI-powered insights on performance metrics and optimization suggestions."
                                           Style="{StaticResource BodyStyle}" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <!-- Presentation Builder -->
                        <Border Grid.Column="2" Grid.Row="1" Style="{StaticResource CardSmallStyle}">
                            <StackPanel Spacing="12">
                                <Grid>
                                    <Border Width="44" Height="44" CornerRadius="10" Background="#2A1A00"
                                            HorizontalAlignment="Left">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7C9;"
                                                  FontSize="20" Foreground="#FF9800"/>
                                    </Border>
                                    <ToggleSwitch HorizontalAlignment="Right" Margin="0" IsOn="False"/>
                                </Grid>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="PRESENTATION BUILDER" Style="{StaticResource H5Style}"/>
                                    <Border Style="{StaticResource BadgeStyle}" HorizontalAlignment="Left">
                                        <TextBlock Text="CONTENT" Style="{StaticResource TagStyle}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Create branded PowerPoint presentations from strategy descriptions and market data."
                                           Style="{StaticResource BodyStyle}" FontSize="13"/>
                            </StackPanel>
                        </Border>

                    </Grid>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
