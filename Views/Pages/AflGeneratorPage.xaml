<Page
    x:Class="PotomacAnalyst.Views.Pages.AflGeneratorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════
             TOP BAR  –  Title + Strategy mode tabs
             ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Padding="20,0,20,0"
                BorderBrush="#1E1E1E"
                BorderThickness="0,0,0,1">
            <Grid Height="48">
                <!-- Left: page title -->
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <FontIcon FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE943;"
                              FontSize="14"
                              Foreground="#FEC00F"/>
                    <TextBlock Text="AFL GENERATOR"
                               FontFamily="{StaticResource RajdhaniBold}"
                               FontSize="14"
                               FontWeight="Bold"
                               CharacterSpacing="60"
                               Foreground="White"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Centre: Strategy / Composite / Code tabs -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="4">

                    <TextBlock Text="Strategy"
                               FontFamily="{StaticResource QuicksandRegular}"
                               FontSize="13"
                               Foreground="#555555"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0"/>

                    <!-- Standalone tab (active) -->
                    <Button x:Name="TabStandalone"
                            Content="Standalone"
                            FontFamily="{StaticResource QuicksandMedium}"
                            FontSize="12"
                            Height="28"
                            Padding="14,0"
                            CornerRadius="6"
                            BorderThickness="0"
                            Click="TabStandalone_Click">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground"            Color="#FEC00F"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFD040"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#E6AC00"/>
                            <SolidColorBrush x:Key="ButtonForeground"            Color="#0A0A0B"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#0A0A0B"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed"       Color="#0A0A0B"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed"      Color="Transparent"/>
                        </Button.Resources>
                    </Button>

                    <!-- Entry tab -->
                    <Button x:Name="TabEntry"
                            Content="Entry"
                            FontFamily="{StaticResource QuicksandMedium}"
                            FontSize="12"
                            Height="28"
                            Padding="14,0"
                            CornerRadius="6"
                            BorderThickness="0"
                            Click="TabEntry_Click">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground"            Color="#1E1E1E"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#252525"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#2A2A2A"/>
                            <SolidColorBrush x:Key="ButtonForeground"            Color="#888888"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#CCCCCC"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed"       Color="White"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed"      Color="Transparent"/>
                        </Button.Resources>
                    </Button>

                    <!-- Exit tab -->
                    <Button x:Name="TabExit"
                            Content="Exit"
                            FontFamily="{StaticResource QuicksandMedium}"
                            FontSize="12"
                            Height="28"
                            Padding="14,0"
                            CornerRadius="6"
                            BorderThickness="0"
                            Click="TabExit_Click">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground"            Color="#1E1E1E"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#252525"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#2A2A2A"/>
                            <SolidColorBrush x:Key="ButtonForeground"            Color="#888888"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#CCCCCC"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed"       Color="White"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed"      Color="Transparent"/>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <!-- Right: Composite toggle + Code button -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="8">

                    <!-- Composite toggle -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="CompositeToggle"
                                      OffContent=""
                                      OnContent=""
                                      MinWidth="0"
                                      IsOn="False"
                                      Toggled="CompositeToggle_Toggled"/>
                        <TextBlock Text="Composite"
                                   FontFamily="{StaticResource QuicksandRegular}"
                                   FontSize="13"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Code button -->
                    <Button x:Name="CodePanelBtn"
                            Height="28"
                            Padding="12,0"
                            CornerRadius="6"
                            BorderThickness="1"
                            Click="ToggleCodePanel_Click">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground"            Color="#1A1A1A"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#242424"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#2A2A2A"/>
                            <SolidColorBrush x:Key="ButtonForeground"            Color="#888888"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#CCCCCC"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush"            Color="#2A2A2A"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#3A3A3A"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed"      Color="#3A3A3A"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE943;"
                                      FontSize="11"
                                      Foreground="#888888"/>
                            <TextBlock Text="Code"
                                       FontFamily="{StaticResource QuicksandMedium}"
                                       FontSize="12"
                                       Foreground="#888888"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             THREE-COLUMN BODY
             ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="CodePanelColumn" Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- ────────────────────────────────────────────
                 LEFT  –  Session list
                 ──────────────────────────────────────────── -->
            <Grid Grid.Column="0"
                  Background="{StaticResource SidebarBackgroundBrush}">
                <Grid.BorderBrush>
                    <SolidColorBrush Color="#1E1E1E"/>
                </Grid.BorderBrush>
                <Grid.BorderThickness>0,0,1,0</Grid.BorderThickness>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sidebar header -->
                <StackPanel Grid.Row="0" Padding="14,16,14,10" Spacing="10">

                    <!-- New AFL Chat button -->
                    <Button FontFamily="{StaticResource RajdhaniBold}"
                            FontSize="12"
                            FontWeight="Bold"
                            CharacterSpacing="40"
                            HorizontalAlignment="Stretch"
                            Height="38"
                            CornerRadius="8"
                            BorderThickness="0"
                            Click="NewAflChat_Click">
                        <Button.Resources>
                            <SolidColorBrush x:Key="ButtonBackground"            Color="#FEC00F"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFD040"/>
                            <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#E6AC00"/>
                            <SolidColorBrush x:Key="ButtonForeground"            Color="#0A0A0B"/>
                            <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#0A0A0B"/>
                            <SolidColorBrush x:Key="ButtonForegroundPressed"       Color="#0A0A0B"/>
                            <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="ButtonBorderBrushPressed"      Color="Transparent"/>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="+"
                                       FontSize="16"
                                       Foreground="#0A0A0B"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="New AFL Chat"
                                       FontFamily="{StaticResource QuicksandMedium}"
                                       FontSize="13"
                                       Foreground="#0A0A0B"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Search -->
                    <TextBox x:Name="SearchBox"
                             PlaceholderText="Search AFLs..."
                             Height="34"
                             CornerRadius="8"
                             FontFamily="{StaticResource QuicksandRegular}"
                             FontSize="12"
                             TextChanged="SearchBox_TextChanged">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground"                      Color="#1A1A1A"/>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused"                Color="#1A1A1A"/>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver"            Color="#202020"/>
                            <SolidColorBrush x:Key="TextControlBorderBrush"                      Color="#2A2A2A"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused"               Color="#3A3A3A"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"           Color="#333333"/>
                            <SolidColorBrush x:Key="TextControlForeground"                       Color="#F0F0F0"/>
                            <SolidColorBrush x:Key="TextControlForegroundFocused"                Color="#F0F0F0"/>
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground"            Color="#555555"/>
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused"     Color="#555555"/>
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#555555"/>
                        </TextBox.Resources>
                    </TextBox>

                </StackPanel>

                <!-- Session list -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SessionList"
                                Spacing="1"
                                Padding="8,0,8,16"/>
                </ScrollViewer>
            </Grid>

            <!-- ────────────────────────────────────────────
                 CENTRE  –  Chat / messages
                 ──────────────────────────────────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Messages -->
                <ScrollViewer x:Name="ChatScrollViewer"
                              Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MessageList"
                                Spacing="0"
                                Padding="28,20,28,16">

                        <!-- Empty/welcome state -->
                        <StackPanel x:Name="WelcomePanel"
                                    HorizontalAlignment="Center"
                                    Spacing="14"
                                    Margin="0,100,0,0">
                            <Border Width="68" Height="68"
                                    CornerRadius="34"
                                    HorizontalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="#1A1600"/>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#2A2200"/>
                                </Border.BorderBrush>
                                <Border.BorderThickness>1</Border.BorderThickness>
                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE943;"
                                          FontSize="26"
                                          Foreground="#FEC00F"/>
                            </Border>

                            <TextBlock Text="DESCRIBE YOUR STRATEGY"
                                       FontFamily="{StaticResource RajdhaniBold}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       CharacterSpacing="60"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>

                            <TextBlock Text="Tell me what trading strategy you want to build&#xA;and I'll generate the AFL code for you."
                                       FontFamily="{StaticResource QuicksandRegular}"
                                       FontSize="13"
                                       Foreground="#555555"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       MaxWidth="360"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- Input bar -->
                <Border Grid.Row="1"
                        Padding="20,12,20,16"
                        BorderBrush="#1A1A1A"
                        BorderThickness="0,1,0,0"
                        Background="{StaticResource AppBackgroundBrush}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Input pill -->
                        <Border Grid.Column="0"
                                CornerRadius="10"
                                BorderThickness="1"
                                Padding="16,0,8,0"
                                MinHeight="46">
                            <Border.Background>
                                <SolidColorBrush Color="#161616"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#2A2A2A"/>
                            </Border.BorderBrush>
                            <TextBox x:Name="ChatInput"
                                     FontFamily="{StaticResource QuicksandRegular}"
                                     FontSize="14"
                                     PlaceholderText="Describe your trading strategy or paste AFL code to analyze..."
                                     AcceptsReturn="False"
                                     MaxHeight="100"
                                     TextWrapping="Wrap"
                                     VerticalAlignment="Center"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     KeyDown="ChatInput_KeyDown">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackground"                      Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused"                Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver"            Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBorderBrush"                      Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused"               Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"           Color="Transparent"/>
                                    <SolidColorBrush x:Key="TextControlForeground"                       Color="#F0F0F0"/>
                                    <SolidColorBrush x:Key="TextControlForegroundFocused"                Color="#F0F0F0"/>
                                    <SolidColorBrush x:Key="TextControlPlaceholderForeground"            Color="#444444"/>
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused"     Color="#444444"/>
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#444444"/>
                                </TextBox.Resources>
                            </TextBox>
                        </Border>

                        <!-- Send button -->
                        <Button x:Name="SendBtn"
                                Grid.Column="1"
                                Width="46" Height="46"
                                CornerRadius="10"
                                BorderThickness="0"
                                Padding="0"
                                Click="GenerateCode_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground"            Color="#FEC00F"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFD040"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#E6AC00"/>
                                <SolidColorBrush x:Key="ButtonForeground"            Color="#0A0A0B"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#0A0A0B"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed"       Color="#0A0A0B"/>
                                <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"      Color="Transparent"/>
                            </Button.Resources>
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE725;"
                                      FontSize="16"
                                      Foreground="#0A0A0B"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ────────────────────────────────────────────
                 RIGHT  –  AFL Code panel
                 ──────────────────────────────────────────── -->
            <Grid Grid.Column="2"
                  x:Name="CodePanel"
                  Background="#0D1117">
                <Grid.BorderBrush>
                    <SolidColorBrush Color="#1E1E1E"/>
                </Grid.BorderBrush>
                <Grid.BorderThickness>1,0,0,0</Grid.BorderThickness>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Code panel header -->
                <Border Grid.Row="0"
                        Padding="16,10"
                        BorderBrush="#1E1E1E"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <!-- AFL CODE label -->
                            <TextBlock Text="AFL CODE"
                                       FontFamily="{StaticResource RajdhaniBold}"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       CharacterSpacing="60"
                                       Foreground="#FEC00F"
                                       VerticalAlignment="Center"/>
                            <!-- Mode badge (e.g. STANDALONE) -->
                            <Border CornerRadius="4"
                                    Padding="8,2"
                                    Background="#1A1600"
                                    BorderThickness="1">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#2A2200"/>
                                </Border.BorderBrush>
                                <TextBlock x:Name="ModeBadge"
                                           Text="STANDALONE"
                                           FontFamily="{StaticResource RajdhaniBold}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           CharacterSpacing="50"
                                           Foreground="#FEC00F"/>
                            </Border>
                        </StackPanel>

                        <!-- Action buttons top-right -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="4">
                            <!-- Expand -->
                            <Button Width="28" Height="28"
                                    CornerRadius="6" BorderThickness="0" Padding="0">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground"            Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1E1E1E"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#252525"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed"      Color="Transparent"/>
                                </Button.Resources>
                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE1D8;"
                                          FontSize="12"
                                          Foreground="#555555"/>
                            </Button>
                            <!-- Copy -->
                            <Button Width="28" Height="28"
                                    CornerRadius="6" BorderThickness="0" Padding="0"
                                    Click="CopyCode_Click">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground"            Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1E1E1E"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#252525"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed"      Color="Transparent"/>
                                </Button.Resources>
                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE8C8;"
                                          FontSize="12"
                                          Foreground="#555555"/>
                            </Button>
                            <!-- Close panel -->
                            <Button Width="28" Height="28"
                                    CornerRadius="6" BorderThickness="0" Padding="0"
                                    Click="ToggleCodePanel_Click">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground"            Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1E1E1E"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#252525"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed"      Color="Transparent"/>
                                </Button.Resources>
                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE8BB;"
                                          FontSize="12"
                                          Foreground="#555555"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Code editor area -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="#0D1117">
                    <TextBox x:Name="CodeOutput"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="12"
                             Background="Transparent"
                             Foreground="#E6EDF3"
                             BorderThickness="0"
                             IsReadOnly="False"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             Padding="20,16"
                             PlaceholderText="// Generated AFL code will appear here..."
                             TextChanged="CodeOutput_TextChanged">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground"            Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundFocused"      Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver"  Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrush"            Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused"     Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent"/>
                            <SolidColorBrush x:Key="TextControlForeground"             Color="#E6EDF3"/>
                            <SolidColorBrush x:Key="TextControlForegroundFocused"      Color="#E6EDF3"/>
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground"  Color="#3A3A3A"/>
                            <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#33FEC00F"/>
                        </TextBox.Resources>
                    </TextBox>
                </ScrollViewer>

                <!-- Bottom action tabs: Optimize / Debug / Explain / Feedback -->
                <Border Grid.Row="2"
                        BorderBrush="#1E1E1E"
                        BorderThickness="0,1,0,0"
                        Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="2">

                        <Button x:Name="BtnOptimize"
                                Content="Optimize"
                                FontFamily="{StaticResource QuicksandMedium}"
                                FontSize="12"
                                Height="30"
                                Padding="12,0"
                                CornerRadius="6"
                                BorderThickness="0"
                                Click="Optimize_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground"            Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1E1E1E"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#252525"/>
                                <SolidColorBrush x:Key="ButtonForeground"            Color="#888888"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#CCCCCC"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed"       Color="White"/>
                                <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"      Color="Transparent"/>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="BtnDebug"
                                Content="Debug"
                                FontFamily="{StaticResource QuicksandMedium}"
                                FontSize="12"
                                Height="30"
                                Padding="12,0"
                                CornerRadius="6"
                                BorderThickness="0"
                                Click="Debug_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground"            Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1E1E1E"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#252525"/>
                                <SolidColorBrush x:Key="ButtonForeground"            Color="#888888"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#CCCCCC"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed"       Color="White"/>
                                <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"      Color="Transparent"/>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="BtnExplain"
                                Content="Explain"
                                FontFamily="{StaticResource QuicksandMedium}"
                                FontSize="12"
                                Height="30"
                                Padding="12,0"
                                CornerRadius="6"
                                BorderThickness="0"
                                Click="Explain_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground"            Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1E1E1E"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#252525"/>
                                <SolidColorBrush x:Key="ButtonForeground"            Color="#888888"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#CCCCCC"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed"       Color="White"/>
                                <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"      Color="Transparent"/>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="BtnFeedback"
                                Content="Feedback"
                                FontFamily="{StaticResource QuicksandMedium}"
                                FontSize="12"
                                Height="30"
                                Padding="12,0"
                                CornerRadius="6"
                                BorderThickness="0"
                                Click="Feedback_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground"            Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1E1E1E"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed"      Color="#252525"/>
                                <SolidColorBrush x:Key="ButtonForeground"            Color="#888888"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"  Color="#CCCCCC"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed"       Color="White"/>
                                <SolidColorBrush x:Key="ButtonBorderBrush"            Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"      Color="Transparent"/>
                            </Button.Resources>
                        </Button>

                        <!-- Line count right-aligned -->
                        <TextBlock x:Name="LineCountLabel"
                                   Text="0 lines"
                                   FontFamily="{StaticResource QuicksandRegular}"
                                   FontSize="11"
                                   Foreground="#444444"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="8,0,4,0"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Page>
