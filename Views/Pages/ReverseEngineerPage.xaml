<Page
    x:Class="PotomacAnalyst.Views.Pages.ReverseEngineerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header -->
        <Border Grid.Row="0" Padding="48,32,48,24"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="6">
                <TextBlock Text="REVERSE ENGINEER" Style="{StaticResource H2Style}"/>
                <TextBlock Text="Analyze an existing strategy description and generate equivalent AFL code"
                           Style="{StaticResource BodyStyle}"/>
            </StackPanel>
        </Border>

        <!-- Two-column layout: wizard + output -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Wizard panel -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          BorderBrush="{StaticResource BorderBrush}"
                          BorderThickness="0,0,1,0">
                <StackPanel Padding="32,32,32,48" Spacing="28">

                    <!-- Step progress -->
                    <StackPanel Spacing="16">
                        <TextBlock Text="SETUP WIZARD" Style="{StaticResource H4Style}"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="4" CornerRadius="2"
                                    Background="{StaticResource PotomacYellowBrush}"/>
                            <TextBlock Grid.Column="1" Text="1"
                                       FontFamily="{StaticResource RajdhaniBold}"
                                       FontSize="12" Foreground="{StaticResource PotomacYellowBrush}"/>
                            <Border Grid.Column="2" Height="4" CornerRadius="2"
                                    x:Name="Step2Line" Background="{StaticResource BorderBrush}"/>
                            <TextBlock Grid.Column="3" Text="2"
                                       FontFamily="{StaticResource RajdhaniBold}"
                                       FontSize="12" x:Name="Step2Num"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <Border Grid.Column="4" Height="4" CornerRadius="2"
                                    x:Name="Step3Line" Background="{StaticResource BorderBrush}"/>
                            <TextBlock Grid.Column="5" Text="3"
                                       FontFamily="{StaticResource RajdhaniBold}"
                                       FontSize="12" x:Name="Step3Num"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                            <Border Grid.Column="6" Height="4" CornerRadius="2"
                                    x:Name="Step4Line" Background="{StaticResource BorderBrush}"/>
                        </Grid>
                    </StackPanel>

                    <!-- Step 1: Strategy description -->
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="24" Height="24" CornerRadius="12"
                                    Background="{StaticResource PotomacYellowBrush}">
                                <TextBlock Text="1"
                                           FontFamily="{StaticResource RajdhaniBold}"
                                           FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource PotomacDarkGrayBrush}"/>
                            </Border>
                            <TextBlock Text="STRATEGY DESCRIPTION"
                                       Style="{StaticResource H5Style}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox x:Name="StrategyDesc"
                                 Style="{StaticResource MultilineInputStyle}"
                                 PlaceholderText="Describe the trading strategy you want to reverse engineer. Include entry/exit conditions, indicators used, and any specific rules..."
                                 Height="120"/>
                    </StackPanel>

                    <!-- Step 2: Asset class -->
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="24" Height="24" CornerRadius="12"
                                    Background="{StaticResource BorderBrush}">
                                <TextBlock Text="2"
                                           FontFamily="{StaticResource RajdhaniBold}"
                                           FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                            <TextBlock Text="ASSET CLASS"
                                       Style="{StaticResource H5Style}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox x:Name="AssetClassBox"
                                  Style="{StaticResource ComboInputStyle}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Select asset class">
                            <ComboBoxItem Content="Equities"/>
                            <ComboBoxItem Content="Futures"/>
                            <ComboBoxItem Content="Forex"/>
                            <ComboBoxItem Content="Crypto"/>
                            <ComboBoxItem Content="Options"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Step 3: Timeframe -->
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="24" Height="24" CornerRadius="12"
                                    Background="{StaticResource BorderBrush}">
                                <TextBlock Text="3"
                                           FontFamily="{StaticResource RajdhaniBold}"
                                           FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                            <TextBlock Text="TIMEFRAME"
                                       Style="{StaticResource H5Style}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox x:Name="TimeframeBox"
                                  Style="{StaticResource ComboInputStyle}"
                                  HorizontalAlignment="Stretch"
                                  PlaceholderText="Select timeframe">
                            <ComboBoxItem Content="1 Minute"/>
                            <ComboBoxItem Content="5 Minutes"/>
                            <ComboBoxItem Content="15 Minutes"/>
                            <ComboBoxItem Content="1 Hour"/>
                            <ComboBoxItem Content="Daily"/>
                            <ComboBoxItem Content="Weekly"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Step 4: Additional context -->
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="24" Height="24" CornerRadius="12"
                                    Background="{StaticResource BorderBrush}">
                                <TextBlock Text="4"
                                           FontFamily="{StaticResource RajdhaniBold}"
                                           FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                            <TextBlock Text="ADDITIONAL CONTEXT"
                                       Style="{StaticResource H5Style}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox x:Name="AdditionalContext"
                                 Style="{StaticResource MultilineInputStyle}"
                                 PlaceholderText="Any additional parameters, risk management rules, or specific AFL functions to include..."
                                 Height="80"/>
                    </StackPanel>

                    <!-- Generate button -->
                    <Button x:Name="GenerateBtn"
                            Content="GENERATE AFL CODE"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="GenerateAfl_Click"/>

                    <ProgressBar x:Name="LoadingBar"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed"
                                 Foreground="{StaticResource PotomacYellowBrush}"
                                 Background="{StaticResource BorderBrush}"
                                 Height="3"/>

                </StackPanel>
            </ScrollViewer>

            <!-- AFL Output panel -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Output header -->
                <Border Grid.Row="0" Padding="24,16"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="GENERATED AFL CODE"
                                   Style="{StaticResource H4Style}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Right">
                            <Button Content="COPY"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="14,8" FontSize="12"
                                    Click="CopyCode_Click"/>
                            <Button Content="CLEAR"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="14,8" FontSize="12"
                                    Click="ClearCode_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Code output -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Border Background="#0D1117" Padding="24">
                        <TextBox x:Name="AflOutput"
                                 FontFamily="Cascadia Code, Consolas, Courier New"
                                 FontSize="13"
                                 Background="Transparent"
                                 Foreground="#E6EDF3"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 PlaceholderText="Generated AFL code will appear here..."/>
                    </Border>
                </ScrollViewer>

                <!-- Action bar -->
                <Border Grid.Row="2" Padding="24,12"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="SEND TO AFL GENERATOR"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Padding="16,10"
                                Click="SendToAfl_Click"/>
                        <Button Content="TEST IN BACKTEST"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="16,10"
                                Click="SendToBacktest_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
