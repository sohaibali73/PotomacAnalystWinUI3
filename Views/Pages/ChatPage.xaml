<Page
    x:Class="PotomacAnalyst.Views.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════
             LEFT  –  Conversations sidebar
             ═══════════════════════════════════════════════════ -->
        <Grid Grid.Column="0"
              Background="{StaticResource SidebarBackgroundBrush}"
              BorderBrush="#2A2A2A"
              BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Sidebar top bar -->
            <StackPanel Grid.Row="0" Padding="16,20,16,12" Spacing="12">

                <TextBlock Text="CONVERSATIONS"
                           FontFamily="{StaticResource RajdhaniBold}"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           CharacterSpacing="83"/>

                <!-- New Chat button -->
                <Button x:Name="NewChatBtn"
                        Content="+ NEW CHAT"
                        FontFamily="{StaticResource RajdhaniBold}"
                        FontSize="13"
                        FontWeight="Bold"
                        CharacterSpacing="50"
                        HorizontalAlignment="Stretch"
                        Height="40"
                        CornerRadius="8"
                        BorderThickness="0"
                        Click="NewChat_Click">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground"             Color="#FEC00F"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="#FFD040"/>
                        <SolidColorBrush x:Key="ButtonBackgroundPressed"       Color="#E6AC00"/>
                        <SolidColorBrush x:Key="ButtonForeground"             Color="#0A0A0B"/>
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver"   Color="#0A0A0B"/>
                        <SolidColorBrush x:Key="ButtonForegroundPressed"        Color="#0A0A0B"/>
                        <SolidColorBrush x:Key="ButtonBorderBrush"             Color="Transparent"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"  Color="Transparent"/>
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed"       Color="Transparent"/>
                    </Button.Resources>
                </Button>

                <!-- Search box -->
                <!-- FIX: PlaceholderText is correct WinUI 3 API (NOT HintText which is UWP legacy) -->
                <TextBox x:Name="SearchBox"
                         PlaceholderText="Search conversations..."
                         Height="36"
                         CornerRadius="8"
                         FontFamily="{StaticResource QuicksandRegular}"
                         FontSize="13"
                         TextChanged="SearchBox_TextChanged">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground"                       Color="#1A1A1A"/>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused"                 Color="#1A1A1A"/>
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver"             Color="#202020"/>
                        <SolidColorBrush x:Key="TextControlBorderBrush"                       Color="#2A2A2A"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused"                Color="#3A3A3A"/>
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"            Color="#333333"/>
                        <SolidColorBrush x:Key="TextControlForeground"                        Color="#F0F0F0"/>
                        <SolidColorBrush x:Key="TextControlForegroundFocused"                 Color="#F0F0F0"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForeground"             Color="#555555"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused"      Color="#555555"/>
                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver"  Color="#555555"/>
                    </TextBox.Resources>
                </TextBox>

            </StackPanel>

            <!-- Conversation list -->
            <!-- FIX: ScrollBarVisibility enum values are correct in WinUI 3 (Auto, Disabled, Hidden, Visible) -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ConversationList"
                            Spacing="1"
                            Padding="8,0,8,16">
                    <!-- Items injected from code-behind -->
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ═══════════════════════════════════════════════════
             RIGHT  –  Chat area
             ═══════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Chat header ── -->
            <Border Grid.Row="0"
                    Padding="28,14,20,14"
                    BorderBrush="#1E1E1E"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock x:Name="ChatTitle"
                                   Text="NEW CONVERSATION"
                                   FontFamily="{StaticResource RajdhaniBold}"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   CharacterSpacing="60"/>
                        <TextBlock x:Name="ChatSubtitle"
                                   Text="Start a conversation with your AI analyst"
                                   FontFamily="{StaticResource QuicksandRegular}"
                                   FontSize="12"
                                   Foreground="#555555"/>
                    </StackPanel>

                    <!-- Header action buttons (right side) -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Spacing="4">

                        <!-- Rename button -->
                        <Button x:Name="RenameBtn"
                                Width="34" Height="34"
                                CornerRadius="6"
                                BorderThickness="0"
                                Padding="0"
                                Visibility="Collapsed"
                                ToolTipService.ToolTip="Rename conversation"
                                Click="RenameChat_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground"             Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="#1E1E1E"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed"       Color="#252525"/>
                                <SolidColorBrush x:Key="ButtonBorderBrush"             Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"  Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"       Color="Transparent"/>
                            </Button.Resources>
                            <!-- FIX: Use Segoe Fluent Icons (WinUI 3) NOT Segoe Fluent Icons (UWP legacy) -->
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE8AC;"
                                      FontSize="13"
                                      Foreground="#555555"/>
                        </Button>

                        <!-- Clear / trash button -->
                        <Button Width="34" Height="34"
                                CornerRadius="6"
                                BorderThickness="0"
                                Padding="0"
                                ToolTipService.ToolTip="Clear conversation"
                                Click="ClearChat_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground"             Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="#1E1E1E"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed"       Color="#252525"/>
                                <SolidColorBrush x:Key="ButtonBorderBrush"             Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"  Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"       Color="Transparent"/>
                            </Button.Resources>
                            <!-- FIX: Segoe Fluent Icons -->
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE74D;"
                                      FontSize="14"
                                      Foreground="#555555"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Message area ── -->
            <!-- FIX: ScrollBarVisibility.Auto is the correct WinUI 3 enum -->
            <ScrollViewer x:Name="ChatScrollViewer"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,16,24,8">
                <StackPanel x:Name="MessageList" Spacing="2">

                    <!-- Welcome panel (shown when no conversation is active) -->
                    <StackPanel x:Name="WelcomePanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="16"
                                Padding="0,80,0,0">

                        <Border Width="64" Height="64"
                                CornerRadius="16"
                                HorizontalAlignment="Center"
                                Background="#1A1600">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#FEC00F" Opacity="0.3"/>
                            </Border.BorderBrush>
                            <Border.BorderThickness>1</Border.BorderThickness>
                            <!-- FIX: Segoe Fluent Icons -->
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE8BD;"
                                      FontSize="28"
                                      Foreground="#FEC00F"/>
                        </Border>

                        <TextBlock Text="START A CONVERSATION"
                                   FontFamily="{StaticResource RajdhaniBold}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   CharacterSpacing="60"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>

                        <TextBlock Text="Ask your AI analyst anything about trading strategies, market&#xA;research, or AFL code generation."
                                   FontFamily="{StaticResource QuicksandRegular}"
                                   FontSize="13"
                                   Foreground="#555555"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   MaxWidth="380"/>

                        <!-- Prompt chips -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8"
                                    Margin="0,8,0,0">

                            <Button Content="Market overview"
                                    FontFamily="{StaticResource QuicksandRegular}"
                                    FontSize="12"
                                    CornerRadius="20"
                                    Padding="14,7,14,7"
                                    BorderThickness="1"
                                    Click="PromptChip_Click"
                                    Tag="Give me a current market overview with key levels to watch">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground"             Color="#161616"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="#222222"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed"       Color="#1A1A1A"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrush"             Color="#2A2A2A"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"  Color="#FEC00F"/>
                                    <SolidColorBrush x:Key="ButtonForeground"             Color="#AAAAAA"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver"   Color="#F0F0F0"/>
                                </Button.Resources>
                            </Button>

                            <Button Content="Generate AFL strategy"
                                    FontFamily="{StaticResource QuicksandRegular}"
                                    FontSize="12"
                                    CornerRadius="20"
                                    Padding="14,7,14,7"
                                    BorderThickness="1"
                                    Click="PromptChip_Click"
                                    Tag="Generate an AFL momentum strategy with RSI and moving average crossover">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground"             Color="#161616"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="#222222"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed"       Color="#1A1A1A"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrush"             Color="#2A2A2A"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"  Color="#FEC00F"/>
                                    <SolidColorBrush x:Key="ButtonForeground"             Color="#AAAAAA"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver"   Color="#F0F0F0"/>
                                </Button.Resources>
                            </Button>

                            <Button Content="Run a backtest"
                                    FontFamily="{StaticResource QuicksandRegular}"
                                    FontSize="12"
                                    CornerRadius="20"
                                    Padding="14,7,14,7"
                                    BorderThickness="1"
                                    Click="PromptChip_Click"
                                    Tag="Run a backtest on BHP for the last 12 months using a simple moving average crossover">
                                <Button.Resources>
                                    <SolidColorBrush x:Key="ButtonBackground"             Color="#161616"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="#222222"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed"       Color="#1A1A1A"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrush"             Color="#2A2A2A"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"  Color="#FEC00F"/>
                                    <SolidColorBrush x:Key="ButtonForeground"             Color="#AAAAAA"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver"   Color="#F0F0F0"/>
                                </Button.Resources>
                            </Button>

                        </StackPanel>

                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- ── Input bar ── -->
            <Border Grid.Row="2"
                    Padding="20,14,20,18"
                    BorderBrush="#1A1A1A"
                    BorderThickness="0,1,0,0"
                    Background="{StaticResource AppBackgroundBrush}">

                <StackPanel Spacing="8">

                    <!-- Attachment strip — populated by AttachmentsContainer (Inline variant)
                         injected from code-behind. Hidden when empty. -->
                    <StackPanel x:Name="AttachmentStripHost"
                                Visibility="Collapsed"/>

                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Input pill -->
                        <Border Grid.Column="0"
                                CornerRadius="10"
                                BorderThickness="1"
                                Padding="16,0,12,0"
                                MinHeight="48"
                                Background="#161616"
                                BorderBrush="#2A2A2A">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- FIX: AcceptsReturn on TextBox is valid WinUI 3. -->
                                <!-- FIX: KeyDown is correct WinUI 3 event (NOT PreviewKeyDown which is WPF) -->
                                <TextBox x:Name="MessageInput"
                                         Grid.Column="0"
                                         FontFamily="{StaticResource QuicksandRegular}"
                                         FontSize="14"
                                         PlaceholderText="Message your analyst... (Shift+Enter for new line)"
                                         AcceptsReturn="False"
                                         MaxHeight="120"
                                         TextWrapping="Wrap"
                                         VerticalAlignment="Center"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         KeyDown="MessageInput_KeyDown">
                                    <TextBox.Resources>
                                        <SolidColorBrush x:Key="TextControlBackground"                       Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBackgroundFocused"                 Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver"             Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrush"                       Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused"                Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver"            Color="Transparent"/>
                                        <SolidColorBrush x:Key="TextControlForeground"                        Color="#F0F0F0"/>
                                        <SolidColorBrush x:Key="TextControlForegroundFocused"                 Color="#F0F0F0"/>
                                        <SolidColorBrush x:Key="TextControlPlaceholderForeground"             Color="#444444"/>
                                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused"      Color="#444444"/>
                                        <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver"  Color="#444444"/>
                                    </TextBox.Resources>
                                </TextBox>

                                <!-- Attach button inside pill -->
                                <!-- FIX: ToolTipService is correct WinUI 3 (ToolTip attached property) -->
                                <Button Grid.Column="1"
                                        x:Name="AttachBtn"
                                        Width="32" Height="32"
                                        CornerRadius="6"
                                        BorderThickness="0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Attach file (PDF, CSV, XLSX, TXT)"
                                        Click="AttachFile_Click">
                                    <Button.Resources>
                                        <SolidColorBrush x:Key="ButtonBackground"             Color="Transparent"/>
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="#242424"/>
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed"       Color="#2E2E2E"/>
                                        <SolidColorBrush x:Key="ButtonBorderBrush"             Color="Transparent"/>
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"  Color="Transparent"/>
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed"       Color="Transparent"/>
                                    </Button.Resources>
                                    <!-- FIX: Segoe Fluent Icons (&#xE723; is the same paperclip glyph, valid in both,
                                         but Segoe Fluent Icons is the WinUI 3 standard font) -->
                                    <FontIcon x:Name="AttachIcon"
                                              FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE723;"
                                              FontSize="13"
                                              Foreground="#555555"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Send / Stop button — same button, icon swaps during stream -->
                        <Button x:Name="SendBtn"
                                Grid.Column="1"
                                Width="48" Height="48"
                                CornerRadius="10"
                                BorderThickness="0"
                                Padding="0"
                                ToolTipService.ToolTip="Send message (Enter)"
                                Click="SendMessage_Click">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackground"             Color="#FEC00F"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver"  Color="#FFD040"/>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed"       Color="#E6AC00"/>
                                <SolidColorBrush x:Key="ButtonForeground"             Color="#0A0A0B"/>
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver"   Color="#0A0A0B"/>
                                <SolidColorBrush x:Key="ButtonForegroundPressed"        Color="#0A0A0B"/>
                                <SolidColorBrush x:Key="ButtonBorderBrush"             Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver"  Color="Transparent"/>
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed"       Color="Transparent"/>
                            </Button.Resources>
                            <!-- FIX: Segoe Fluent Icons. x:Name on inner icon so code-behind can swap glyph. -->
                            <FontIcon x:Name="SendIcon"
                                      FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE725;"
                                      FontSize="16"
                                      Foreground="#0A0A0B"/>
                        </Button>

                    </Grid>
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Page>
