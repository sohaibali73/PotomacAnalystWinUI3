<Page
    x:Class="PotomacAnalyst.Views.Pages.DeckGeneratorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="48,32,48,24"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="6">
                <TextBlock Text="DECK GENERATOR" Style="{StaticResource H2Style}"/>
                <TextBlock Text="Generate branded PowerPoint presentations automatically"
                           Style="{StaticResource BodyStyle}"/>
            </StackPanel>
        </Border>

        <!-- Two-column layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Config form -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Padding="48,32,48,48" Spacing="24">

                    <TextBlock Text="PRESENTATION SETTINGS" Style="{StaticResource H4Style}"/>

                    <!-- Deck type -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="DECK TYPE" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="DeckType"
                                  Style="{StaticResource ComboInputStyle}"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="Strategy Overview"/>
                            <ComboBoxItem Content="Market Analysis"/>
                            <ComboBoxItem Content="Client Report"/>
                            <ComboBoxItem Content="Research Summary"/>
                            <ComboBoxItem Content="Portfolio Review"/>
                            <ComboBoxItem Content="Custom"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Title -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="PRESENTATION TITLE" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="DeckTitle"
                                 Style="{StaticResource InputStyle}"
                                 PlaceholderText="e.g., Q4 Strategy Overview"/>
                    </StackPanel>

                    <!-- Brief -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="CONTENT BRIEF" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="DeckBrief"
                                 Style="{StaticResource MultilineInputStyle}"
                                 PlaceholderText="Describe the key points you want covered in this presentation. Include any specific data, strategies, or talking points..."
                                 Height="140"/>
                    </StackPanel>

                    <!-- Slide count -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="NUMBER OF SLIDES" Style="{StaticResource LabelStyle}"/>
                        <ComboBox x:Name="SlideCount"
                                  Style="{StaticResource ComboInputStyle}"
                                  HorizontalAlignment="Stretch"
                                  SelectedIndex="1">
                            <ComboBoxItem Content="5 Slides"/>
                            <ComboBoxItem Content="10 Slides"/>
                            <ComboBoxItem Content="15 Slides"/>
                            <ComboBoxItem Content="20 Slides"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Chart images -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="ATTACH CHARTS (OPTIONAL)" Style="{StaticResource LabelStyle}"/>
                        <Border Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                Padding="16" MinHeight="80"
                                AllowDrop="True"
                                DragOver="ChartDrop_DragOver"
                                Drop="ChartDrop_Drop">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7EF;"
                                          FontSize="24" Foreground="{StaticResource TextMutedBrush}"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="Drop chart images here"
                                           Style="{StaticResource CaptionStyle}"
                                           HorizontalAlignment="Center"/>
                                <Button Content="BROWSE IMAGES"
                                        Style="{StaticResource GhostButtonStyle}"
                                        FontFamily="{StaticResource QuicksandRegular}"
                                        FontSize="12"
                                        HorizontalAlignment="Center"
                                        Click="BrowseCharts_Click"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ChartFilesLabel"
                                   Text="No images attached"
                                   Style="{StaticResource CaptionStyle}"/>
                    </StackPanel>

                    <!-- Generate button -->
                    <Button x:Name="GenerateBtn"
                            Content="GENERATE PRESENTATION"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="GenerateBtn_Click"/>

                    <!-- Progress -->
                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Spacing="8">
                        <ProgressBar x:Name="GenerateProgress"
                                     Foreground="{StaticResource PotomacYellowBrush}"
                                     Background="{StaticResource BorderBrush}"
                                     Height="4"/>
                        <TextBlock x:Name="ProgressStatus"
                                   Text="Generating..."
                                   Style="{StaticResource CaptionStyle}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Right: Preview / Download -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="32,20"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="PREVIEW" Style="{StaticResource H4Style}"/>
                </Border>

                <!-- Placeholder / generated preview -->
                <StackPanel x:Name="PreviewPlaceholder"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="16">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7C9;"
                              FontSize="64" Foreground="{StaticResource TextDisabledBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="PRESENTATION PREVIEW"
                               Style="{StaticResource H4Style}"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextDisabledBrush}"/>
                    <TextBlock Text="Configure settings and click Generate to create your presentation"
                               Style="{StaticResource BodyStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               MaxWidth="360"/>
                </StackPanel>

                <Border x:Name="DownloadBar"
                        Grid.Row="2"
                        Padding="32,16"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="DownloadBtn"
                                Content="DOWNLOAD PPTX"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="DownloadBtn_Click"/>
                        <Button Content="REGENERATE"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="GenerateBtn_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
