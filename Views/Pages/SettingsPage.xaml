<Page
    x:Class="PotomacAnalyst.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="48,32,48,24"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="SETTINGS" Style="{StaticResource H2Style}"/>
        </Border>

        <!-- Two-column layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Settings nav -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Padding="16,20,16,20" Spacing="2">
                    <Button x:Name="NavProfile"       Content="PROFILE"
                            Style="{StaticResource NavButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="SettingsNav_Click" Tag="0"
                            Background="{StaticResource PotomacYellowBrush}"
                            Foreground="{StaticResource PotomacDarkGrayBrush}"/>
                    <Button x:Name="NavApiKeys"       Content="API KEYS"
                            Style="{StaticResource NavButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="SettingsNav_Click" Tag="1"/>
                    <Button x:Name="NavAppearance"    Content="APPEARANCE"
                            Style="{StaticResource NavButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="SettingsNav_Click" Tag="2"/>
                    <Button x:Name="NavNotifications" Content="NOTIFICATIONS"
                            Style="{StaticResource NavButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="SettingsNav_Click" Tag="3"/>
                    <Button x:Name="NavSecurity"      Content="SECURITY"
                            Style="{StaticResource NavButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="SettingsNav_Click" Tag="4"/>
                    <Button x:Name="NavAbout"         Content="ABOUT"
                            Style="{StaticResource NavButtonStyle}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Click="SettingsNav_Click" Tag="5"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Settings content — Grid wraps all sections as its single ScrollViewer child -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid>

                    <!-- PROFILE -->
                    <StackPanel x:Name="ProfileSection" Padding="48,32,48,48" Spacing="28">
                        <TextBlock Text="PROFILE SETTINGS" Style="{StaticResource H3Style}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="24">
                                <StackPanel Orientation="Horizontal" Spacing="20">
                                    <Border Width="80" Height="80" CornerRadius="40"
                                            Background="{StaticResource PotomacYellowBrush}">
                                        <TextBlock x:Name="ProfileInitials" Text="U"
                                                   FontFamily="{StaticResource RajdhaniBold}"
                                                   FontSize="32" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource PotomacDarkGrayBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock x:Name="ProfileName" Text="USER NAME"
                                                   Style="{StaticResource H4Style}"/>
                                        <TextBlock x:Name="ProfileEmail" Text="user@potomac.com"
                                                   Style="{StaticResource BodyStyle}"/>
                                        <Border Style="{StaticResource BadgeStyle}" HorizontalAlignment="Left">
                                            <TextBlock Text="ANALYST" Style="{StaticResource TagStyle}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <Border Style="{StaticResource DividerStyle}"/>
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="FULL NAME" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="FullNameBox" Style="{StaticResource InputStyle}"
                                                 PlaceholderText="Your full name"/>
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="EMAIL ADDRESS" Style="{StaticResource LabelStyle}"/>
                                        <TextBox x:Name="EmailBox" Style="{StaticResource InputStyle}"
                                                 IsReadOnly="True"/>
                                    </StackPanel>
                                    <Button Content="SAVE CHANGES" Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Left" Click="SaveProfile_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- API KEYS -->
                    <StackPanel x:Name="ApiKeysSection" Padding="48,32,48,48" Spacing="28"
                                Visibility="Collapsed">
                        <TextBlock Text="API KEY CONFIGURATION" Style="{StaticResource H3Style}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="24">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="ANTHROPIC (CLAUDE)" Style="{StaticResource H5Style}"/>
                                    <TextBlock Text="Required for AI chat and code generation features"
                                               Style="{StaticResource BodyStyle}"/>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="API KEY" Style="{StaticResource LabelStyle}"/>
                                    <PasswordBox x:Name="ClaudeKeyBox" Style="{StaticResource PasswordInputStyle}"
                                                 PlaceholderText="sk-ant-..."/>
                                </StackPanel>
                                <Border Style="{StaticResource DividerStyle}"/>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="TAVILY SEARCH" Style="{StaticResource H5Style}"/>
                                    <TextBlock Text="Used for web research and market data retrieval"
                                               Style="{StaticResource BodyStyle}"/>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="API KEY" Style="{StaticResource LabelStyle}"/>
                                    <PasswordBox x:Name="TavilyKeyBox" Style="{StaticResource PasswordInputStyle}"
                                                 PlaceholderText="tvly-..."/>
                                </StackPanel>
                                <Button Content="SAVE API KEYS" Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Left" Click="SaveApiKeys_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- APPEARANCE -->
                    <StackPanel x:Name="AppearanceSection" Padding="48,32,48,48" Spacing="28"
                                Visibility="Collapsed">
                        <TextBlock Text="APPEARANCE" Style="{StaticResource H3Style}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="20">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="THEME" Style="{StaticResource H5Style}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="60" Height="60" CornerRadius="8"
                                                Background="#121212"
                                                BorderBrush="{StaticResource PotomacYellowBrush}"
                                                BorderThickness="2">
                                            <TextBlock Text="Dark" FontFamily="{StaticResource QuicksandRegular}"
                                                       FontSize="11" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="White"/>
                                        </Border>
                                        <Border Width="60" Height="60" CornerRadius="8"
                                                Background="#FFFFFF"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <TextBlock Text="Light" FontFamily="{StaticResource QuicksandRegular}"
                                                       FontSize="11" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="#212121"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="ACCENT COLOR" Style="{StaticResource H5Style}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="32" Height="32" CornerRadius="16"
                                                Background="#FEC00F" BorderBrush="White" BorderThickness="2"/>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="#00DED1"/>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="#EB2F5C"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- NOTIFICATIONS -->
                    <StackPanel x:Name="NotificationsSection" Padding="48,32,48,48" Spacing="28"
                                Visibility="Collapsed">
                        <TextBlock Text="NOTIFICATION PREFERENCES" Style="{StaticResource H3Style}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="20">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="STRATEGY COMPLETE" Style="{StaticResource BodyMediumStyle}"/>
                                        <TextBlock Text="Notify when AFL generation finishes"
                                                   Style="{StaticResource CaptionStyle}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="NotifyStrategy" HorizontalAlignment="Right"
                                                  IsOn="True" Margin="0"/>
                                </Grid>
                                <Border Style="{StaticResource DividerStyle}"/>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="RESEARCH UPDATES" Style="{StaticResource BodyMediumStyle}"/>
                                        <TextBlock Text="Notify when new research is available"
                                                   Style="{StaticResource CaptionStyle}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="NotifyResearch" HorizontalAlignment="Right"
                                                  IsOn="False" Margin="0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SECURITY -->
                    <StackPanel x:Name="SecuritySection" Padding="48,32,48,48" Spacing="28"
                                Visibility="Collapsed">
                        <TextBlock Text="SECURITY" Style="{StaticResource H3Style}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="24">
                                <TextBlock Text="CHANGE PASSWORD" Style="{StaticResource H5Style}"/>
                                <StackPanel Spacing="16">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="CURRENT PASSWORD" Style="{StaticResource LabelStyle}"/>
                                        <PasswordBox Style="{StaticResource PasswordInputStyle}"
                                                     PlaceholderText="Enter current password"/>
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="NEW PASSWORD" Style="{StaticResource LabelStyle}"/>
                                        <PasswordBox Style="{StaticResource PasswordInputStyle}"
                                                     PlaceholderText="Enter new password"/>
                                    </StackPanel>
                                    <Button Content="UPDATE PASSWORD" Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                                <Border Style="{StaticResource DividerStyle}"/>
                                <StackPanel Spacing="12">
                                    <TextBlock Text="DANGER ZONE" Style="{StaticResource H5Style}"
                                               Foreground="{StaticResource PotomacPinkBrush}"/>
                                    <Button Content="SIGN OUT ALL DEVICES"
                                            Style="{StaticResource DangerButtonStyle}"
                                            HorizontalAlignment="Left"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ABOUT -->
                    <StackPanel x:Name="AboutSection" Padding="48,32,48,48" Spacing="28"
                                Visibility="Collapsed">
                        <TextBlock Text="ABOUT" Style="{StaticResource H3Style}"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <Border Width="56" Height="56" CornerRadius="12"
                                            Background="{StaticResource PotomacYellowBrush}">
                                        <TextBlock Text="P" FontFamily="{StaticResource RajdhaniBold}"
                                                   FontSize="28" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource PotomacDarkGrayBrush}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="POTOMAC ANALYST" Style="{StaticResource H3Style}"/>
                                        <TextBlock Text="Built to Conquer Risk" Style="{StaticResource BodyStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Style="{StaticResource DividerStyle}"/>
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="VERSION" Style="{StaticResource LabelStyle}" Width="120"/>
                                        <TextBlock Text="1.0.0" Style="{StaticResource BodyPrimaryStyle}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="PLATFORM" Style="{StaticResource LabelStyle}" Width="120"/>
                                        <TextBlock Text="Windows 10/11 (WinUI 3)" Style="{StaticResource BodyPrimaryStyle}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="DEVELOPER" Style="{StaticResource LabelStyle}" Width="120"/>
                                        <TextBlock Text="Potomac" Style="{StaticResource BodyPrimaryStyle}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="WEBSITE" Style="{StaticResource LabelStyle}" Width="120"/>
                                        <TextBlock Text="potomac.com"
                                                   Foreground="{StaticResource PotomacYellowBrush}"
                                                   FontFamily="{StaticResource QuicksandRegular}" FontSize="14"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
