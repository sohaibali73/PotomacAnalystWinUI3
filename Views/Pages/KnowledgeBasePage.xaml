<Page
    x:Class="PotomacAnalyst.Views.Pages.KnowledgeBasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Border Grid.Row="0" Padding="48,32,48,24"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Spacing="6">
                    <TextBlock Text="KNOWLEDGE BASE" Style="{StaticResource H2Style}"/>
                    <TextBlock Text="Browse research articles, manage documents, and upload new content"
                               Style="{StaticResource BodyStyle}"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Width="300"
                        Background="{StaticResource InputBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE721;"
                                  FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                                  HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox"
                                 FontFamily="{StaticResource QuicksandRegular}" FontSize="13"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 PlaceholderText="Search knowledge base..."
                                 Padding="36,10,12,10"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Tab Bar -->
        <Border Grid.Row="1" Padding="48,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="TabDiscover"  Content="DISCOVER"
                        Style="{StaticResource TabButtonActiveStyle}" Click="TabDiscover_Click"/>
                <Button x:Name="TabDocuments" Content="DOCUMENTS"
                        Style="{StaticResource TabButtonStyle}"      Click="TabDocuments_Click"/>
                <Button x:Name="TabUpload"    Content="UPLOAD"
                        Style="{StaticResource TabButtonStyle}"      Click="TabUpload_Click"/>
            </StackPanel>
        </Border>

        <!-- Tab Content — ScrollViewer must have exactly ONE child (a Grid) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>

                <!-- DISCOVER TAB -->
                <StackPanel x:Name="DiscoverTab" Padding="48,32,48,48" Spacing="32">
                    <StackPanel Spacing="12">
                        <TextBlock Text="BROWSE BY TOPIC" Style="{StaticResource H4Style}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" FlowDirection="LeftToRight">
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock Text="Trading Strategies" Style="{StaticResource TagStyle}"/>
                            </Border>
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock Text="Risk Management" Style="{StaticResource TagStyle}"/>
                            </Border>
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock Text="Market Analysis" Style="{StaticResource TagStyle}"/>
                            </Border>
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock Text="AFL Code" Style="{StaticResource TagStyle}"/>
                            </Border>
                            <Border Style="{StaticResource BadgeStyle}">
                                <TextBlock Text="Backtesting" Style="{StaticResource TagStyle}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="16">
                        <TextBlock Text="FEATURED RESEARCH" Style="{StaticResource H4Style}"/>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardSmallStyle}">
                                <StackPanel Spacing="10">
                                    <Border Style="{StaticResource BadgeStyle}" HorizontalAlignment="Left">
                                        <TextBlock Text="STRATEGY" Style="{StaticResource TagStyle}"/>
                                    </Border>
                                    <TextBlock Text="MOMENTUM TRADING FUNDAMENTALS" Style="{StaticResource H5Style}"/>
                                    <TextBlock Text="An introduction to momentum-based trading strategies and implementation in AmiBroker."
                                               Style="{StaticResource BodyStyle}" FontSize="13"/>
                                    <Button Content="READ MORE" Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,6" FontSize="12" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardSmallStyle}">
                                <StackPanel Spacing="10">
                                    <Border Style="{StaticResource BadgeStyle}" HorizontalAlignment="Left">
                                        <TextBlock Text="RISK" Style="{StaticResource TagStyle}"/>
                                    </Border>
                                    <TextBlock Text="POSITION SIZING TECHNIQUES" Style="{StaticResource H5Style}"/>
                                    <TextBlock Text="Advanced position sizing including fixed fractional, optimal f, and Kelly criterion."
                                               Style="{StaticResource BodyStyle}" FontSize="13"/>
                                    <Button Content="READ MORE" Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,6" FontSize="12" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardSmallStyle}">
                                <StackPanel Spacing="10">
                                    <Border Style="{StaticResource BadgeStyle}" HorizontalAlignment="Left">
                                        <TextBlock Text="AFL" Style="{StaticResource TagStyle}"/>
                                    </Border>
                                    <TextBlock Text="AFL CODE BEST PRACTICES" Style="{StaticResource H5Style}"/>
                                    <TextBlock Text="Writing clean, efficient, maintainable AmiBroker Formula Language code."
                                               Style="{StaticResource BodyStyle}" FontSize="13"/>
                                    <Button Content="READ MORE" Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="12,6" FontSize="12" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- DOCUMENTS TAB -->
                <StackPanel x:Name="DocumentsTab" Padding="48,32,48,48" Spacing="24"
                            Visibility="Collapsed">
                    <Grid>
                        <TextBlock Text="YOUR DOCUMENTS" Style="{StaticResource H4Style}"/>
                        <Button Content="UPLOAD NEW" Style="{StaticResource PrimaryButtonStyle}"
                                Padding="16,8" FontSize="13" HorizontalAlignment="Right"
                                Click="UploadNew_Click"/>
                    </Grid>
                    <Border Style="{StaticResource CardSmallStyle}" Padding="0">
                        <StackPanel x:Name="DocumentsList">
                            <Border Padding="20,16"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                <TextBlock Text="No documents uploaded yet. Click Upload New to get started."
                                           Style="{StaticResource BodyStyle}"
                                           HorizontalAlignment="Center" Margin="0,16"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- UPLOAD TAB -->
                <StackPanel x:Name="UploadTab" Padding="48,32,48,48" Spacing="24"
                            Visibility="Collapsed">
                    <TextBlock Text="UPLOAD DOCUMENTS" Style="{StaticResource H4Style}"/>
                    <Border Background="{StaticResource CardBackgroundBrush}"
                            BorderBrush="{StaticResource PotomacYellowBrush}"
                            BorderThickness="2" CornerRadius="10" Padding="48"
                            AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE898;"
                                      FontSize="40" Foreground="{StaticResource PotomacYellowBrush}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="DRAG AND DROP FILES HERE"
                                       Style="{StaticResource H4Style}" HorizontalAlignment="Center"/>
                            <TextBlock Text="or click to browse"
                                       Style="{StaticResource BodyStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Supported: PDF, TXT, DOCX, CSV, XLSX"
                                       Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center"/>
                            <Button Content="BROWSE FILES" Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Center" Margin="0,8,0,0"
                                    Click="BrowseFiles_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
