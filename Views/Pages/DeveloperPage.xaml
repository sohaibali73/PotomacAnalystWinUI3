<Page
    x:Class="PotomacAnalyst.Views.Pages.DeveloperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="48,32,48,24"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Spacing="6">
                    <TextBlock Text="DEVELOPER TOOLS" Style="{StaticResource H2Style}"/>
                    <TextBlock Text="API testing, diagnostics, and integration tools"
                               Style="{StaticResource BodyStyle}"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="#2D1515"
                        BorderBrush="{StaticResource PotomacPinkBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="10,5">
                    <TextBlock Text="DEV MODE"
                               FontFamily="{StaticResource RajdhaniBold}"
                               FontSize="11" CharacterSpacing="40"
                               Foreground="{StaticResource PotomacPinkBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="48,32,48,48" Spacing="32">

                <!-- API Status -->
                <StackPanel Spacing="16">
                    <TextBlock Text="API CONNECTION STATUS" Style="{StaticResource H3Style}"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="10" Height="10" CornerRadius="5"
                                        Background="{StaticResource PotomacTurquoiseBrush}"/>
                                <TextBlock Text="Backend API" Style="{StaticResource BodyMediumStyle}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="https://potomac-analyst-workbench-production.up.railway.app"
                                           Style="{StaticResource CaptionStyle}" VerticalAlignment="Center"/>
                                <Button Content="TEST" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,6" FontSize="11" Click="TestApi_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- API Explorer -->
                <StackPanel Spacing="16">
                    <TextBlock Text="API EXPLORER" Style="{StaticResource H3Style}"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="16">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="HttpMethod"
                                          Style="{StaticResource ComboInputStyle}"
                                          Width="100" SelectedIndex="0">
                                    <ComboBoxItem Content="GET"/>
                                    <ComboBoxItem Content="POST"/>
                                    <ComboBoxItem Content="PUT"/>
                                    <ComboBoxItem Content="DELETE"/>
                                </ComboBox>
                                <TextBox Grid.Column="1" x:Name="EndpointBox"
                                         Style="{StaticResource InputStyle}"
                                         PlaceholderText="/api/endpoint"/>
                                <Button Grid.Column="2" Content="SEND"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Padding="16,10" Click="SendRequest_Click"/>
                            </Grid>

                            <TextBox x:Name="RequestBody"
                                     Style="{StaticResource MultilineInputStyle}"
                                     PlaceholderText="Enter JSON request body here..."
                                     Height="80"/>

                            <StackPanel Spacing="8">
                                <TextBlock Text="RESPONSE" Style="{StaticResource LabelStyle}"/>
                                <Border Background="#0D1117" CornerRadius="8" Padding="16" MinHeight="100">
                                    <TextBox x:Name="ResponseBox"
                                             FontFamily="Cascadia Code, Consolas, Courier New"
                                             FontSize="12" Background="Transparent" Foreground="#E6EDF3"
                                             BorderThickness="0" IsReadOnly="True"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             PlaceholderText="Response will appear here..."/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Session info -->
                <StackPanel Spacing="16">
                    <TextBlock Text="SESSION INFORMATION" Style="{StaticResource H3Style}"/>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel x:Name="SessionInfoPanel" Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="AUTH TOKEN" Style="{StaticResource LabelStyle}" Width="140"/>
                                <TextBlock x:Name="TokenDisplay" Text="(loading...)"
                                           Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="AUTHENTICATED" Style="{StaticResource LabelStyle}" Width="140"/>
                                <TextBlock x:Name="AuthStatus" Text="Checking..."
                                           Style="{StaticResource BodyPrimaryStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
