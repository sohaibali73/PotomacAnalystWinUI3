<Page
    x:Class="PotomacAnalyst.Views.Pages.AutopilotPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="48,32,48,24"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Spacing="6">
                    <TextBlock Text="AUTOPILOT" Style="{StaticResource H2Style}"/>
                    <TextBlock Text="Automate recurring research, analysis, and content tasks"
                               Style="{StaticResource BodyStyle}"/>
                </StackPanel>
                <Border HorizontalAlignment="Right"
                        Background="#002A1A"
                        BorderBrush="{StaticResource PotomacTurquoiseBrush}"
                        BorderThickness="1" CornerRadius="20"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource PotomacTurquoiseBrush}"/>
                        <TextBlock Text="AUTOPILOT READY"
                                   FontFamily="{StaticResource RajdhaniBold}"
                                   FontSize="12" CharacterSpacing="30"
                                   Foreground="{StaticResource PotomacTurquoiseBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="48,32,48,48" Spacing="40">

                <!-- Quick setup -->
                <StackPanel Spacing="16">
                    <TextBlock Text="CONFIGURE AUTOPILOT" Style="{StaticResource H3Style}"/>

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="20">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="TASK DESCRIPTION" Style="{StaticResource LabelStyle}"/>
                                    <TextBox x:Name="TaskDesc"
                                             Style="{StaticResource MultilineInputStyle}"
                                             PlaceholderText="Describe what you want Autopilot to do automatically. e.g., Generate weekly market commentary every Monday at 9am..."
                                             Height="120"/>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="SCHEDULE" Style="{StaticResource LabelStyle}"/>
                                    <ComboBox x:Name="Schedule"
                                              Style="{StaticResource ComboInputStyle}"
                                              HorizontalAlignment="Stretch"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Daily"/>
                                        <ComboBoxItem Content="Weekly"/>
                                        <ComboBoxItem Content="Monthly"/>
                                        <ComboBoxItem Content="On Demand"/>
                                    </ComboBox>
                                </StackPanel>
                                <Button Content="CREATE AUTOPILOT TASK"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Click="CreateTask_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="16">
                                <TextBlock Text="QUICK AUTOMATIONS" Style="{StaticResource H4Style}"/>
                                <StackPanel Spacing="8">
                                    <Border Style="{StaticResource CardSmallStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BD;"
                                                      FontSize="16" Foreground="{StaticResource PotomacYellowBrush}"/>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="DAILY MARKET COMMENTARY"
                                                           Style="{StaticResource BodyMediumStyle}" FontSize="13"/>
                                                <TextBlock Text="Auto-generate every morning"
                                                           Style="{StaticResource CaptionStyle}"/>
                                            </StackPanel>
                                            <Button Content="ENABLE" Style="{StaticResource SecondaryButtonStyle}"
                                                    HorizontalAlignment="Right" Padding="10,6" FontSize="11"
                                                    Click="EnableAutomation_Click"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardSmallStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE9F5;"
                                                      FontSize="16" Foreground="{StaticResource PotomacTurquoiseBrush}"/>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="WEEKLY BACKTEST REPORT"
                                                           Style="{StaticResource BodyMediumStyle}" FontSize="13"/>
                                                <TextBlock Text="Analyze strategies every Friday"
                                                           Style="{StaticResource CaptionStyle}"/>
                                            </StackPanel>
                                            <Button Content="ENABLE" Style="{StaticResource SecondaryButtonStyle}"
                                                    HorizontalAlignment="Right" Padding="10,6" FontSize="11"
                                                    Click="EnableAutomation_Click"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardSmallStyle}">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7C9;"
                                                      FontSize="16" Foreground="#FF9800"/>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="MONTHLY CLIENT DECK"
                                                           Style="{StaticResource BodyMediumStyle}" FontSize="13"/>
                                                <TextBlock Text="Auto-generate first of each month"
                                                           Style="{StaticResource CaptionStyle}"/>
                                            </StackPanel>
                                            <Button Content="ENABLE" Style="{StaticResource SecondaryButtonStyle}"
                                                    HorizontalAlignment="Right" Padding="10,6" FontSize="11"
                                                    Click="EnableAutomation_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Active tasks -->
                <StackPanel Spacing="16">
                    <TextBlock Text="ACTIVE TASKS" Style="{StaticResource H3Style}"/>
                    <Border Style="{StaticResource CardSmallStyle}" Padding="32">
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE768;"
                                      FontSize="40" Foreground="{StaticResource TextDisabledBrush}"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="NO ACTIVE TASKS"
                                       Style="{StaticResource H4Style}"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextDisabledBrush}"/>
                            <TextBlock Text="Create a task above to start automating your workflow"
                                       Style="{StaticResource BodyStyle}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
