<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         POTOMAC BRAND COLORS
    ================================================================ -->
    <SolidColorBrush x:Key="PotomacYellowBrush"    Color="#FEC00F"/>
    <SolidColorBrush x:Key="PotomacYellowDarkBrush" Color="#E5AE0E"/>
    <SolidColorBrush x:Key="PotomacDarkGrayBrush"   Color="#212121"/>
    <SolidColorBrush x:Key="PotomacTurquoiseBrush"  Color="#00DED1"/>
    <SolidColorBrush x:Key="PotomacPinkBrush"       Color="#EB2F5C"/>
    <SolidColorBrush x:Key="PotomacGreenBrush"      Color="#4CAF50"/>
    <SolidColorBrush x:Key="PotomacOrangeBrush"     Color="#FF9800"/>
    <SolidColorBrush x:Key="PotomacPurpleBrush"     Color="#7B68EE"/>

    <!-- Semantic palette (dark mode) — these layer on top of Mica -->
    <SolidColorBrush x:Key="AppBackgroundBrush"     Color="Transparent"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"    Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="InputBackgroundBrush"   Color="#1E1E1E"/>
    <SolidColorBrush x:Key="BorderBrush"            Color="#333333"/>
    <SolidColorBrush x:Key="BorderLightBrush"       Color="#2A2A2A"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"       Color="#F2F2F2"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"     Color="#8A8A8A"/>
    <SolidColorBrush x:Key="TextMutedBrush"         Color="#505050"/>
    <SolidColorBrush x:Key="TextDisabledBrush"      Color="#363636"/>
    <SolidColorBrush x:Key="TransparentBrush"       Color="Transparent"/>

    <!-- ================================================================
         FONTS
    ================================================================ -->
    <FontFamily x:Key="RajdhaniBold">ms-appx:///Assets/Fonts/Rajdhani-Bold.ttf#Rajdhani</FontFamily>
    <FontFamily x:Key="RajdhaniMedium">ms-appx:///Assets/Fonts/Rajdhani-Medium.ttf#Rajdhani</FontFamily>
    <FontFamily x:Key="RajdhaniLight">ms-appx:///Assets/Fonts/Rajdhani-Light.ttf#Rajdhani</FontFamily>
    <FontFamily x:Key="QuicksandBold">ms-appx:///Assets/Fonts/Quicksand-Bold.ttf#Quicksand</FontFamily>
    <FontFamily x:Key="QuicksandMedium">ms-appx:///Assets/Fonts/Quicksand-Medium.ttf#Quicksand</FontFamily>
    <FontFamily x:Key="QuicksandRegular">ms-appx:///Assets/Fonts/Quicksand-Regular.ttf#Quicksand</FontFamily>
    <FontFamily x:Key="QuicksandLight">ms-appx:///Assets/Fonts/Quicksand-Light.ttf#Quicksand</FontFamily>

    <!-- ================================================================
         NAVIGATION VIEW — Potomac brand overrides
         The pane is Transparent so Mica shows through; items get yellow.
    ================================================================ -->
    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground"  Color="Transparent"/>
    <SolidColorBrush x:Key="NavigationViewTopPaneBackground"      Color="Transparent"/>
    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="NavigationViewContentBackground"      Color="Transparent"/>

    <!-- Selected item: yellow fill, dark text -->
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected"              Color="#FEC00F"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver"   Color="#FFD040"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed"       Color="#E5AE0E"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelected"              Color="#0A0A0B"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver"   Color="#0A0A0B"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed"       Color="#0A0A0B"/>

    <!-- Unselected items -->
    <SolidColorBrush x:Key="NavigationViewItemForeground"                      Color="#8A8A8A"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver"           Color="#F2F2F2"/>
    <SolidColorBrush x:Key="NavigationViewItemForegroundPressed"               Color="#F2F2F2"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver"           Color="#1F1F1F"/>
    <SolidColorBrush x:Key="NavigationViewItemBackgroundPressed"               Color="#2A2A2A"/>

    <!-- Header text style -->
    <SolidColorBrush x:Key="NavigationViewItemHeaderForeground"                Color="#FEC00F"/>

    <!-- Override NavigationViewItem font to use Quicksand -->
    <Style TargetType="NavigationViewItem">
        <Setter Property="FontFamily" Value="{StaticResource QuicksandMedium}"/>
        <Setter Property="FontSize"   Value="13"/>
    </Style>

    <!-- Override NavigationViewItemHeader font -->
    <Style TargetType="NavigationViewItemHeader">
        <Setter Property="FontFamily" Value="{StaticResource RajdhaniBold}"/>
        <Setter Property="FontSize"   Value="10"/>
        <Setter Property="CharacterSpacing" Value="60"/>
    </Style>

    <!-- ================================================================
         TEXT STYLES
    ================================================================ -->
    <Style x:Key="H1Style" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RajdhaniBold}"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="80"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="H2Style" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RajdhaniBold}"/>
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="60"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="H3Style" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RajdhaniBold}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="50"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="H4Style" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RajdhaniBold}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="40"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="H5Style" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RajdhaniBold}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>
    <Style x:Key="BodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource QuicksandRegular}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="BodyPrimaryStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource QuicksandRegular}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="BodyMediumStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource QuicksandMedium}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource QuicksandRegular}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
    </Style>
    <Style x:Key="LabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource QuicksandMedium}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="50"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>
    <Style x:Key="YellowAccentStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource RajdhaniBold}"/>
        <Setter Property="FontSize" Value="36"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="80"/>
        <Setter Property="Foreground" Value="{StaticResource PotomacYellowBrush}"/>
    </Style>
    <Style x:Key="TagStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource QuicksandMedium}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource PotomacYellowBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CharacterSpacing" Value="40"/>
    </Style>

    <!-- ================================================================
         BUTTON STYLES
    ================================================================ -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource RajdhaniBold}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="60"/>
        <Setter Property="Background" Value="{StaticResource PotomacYellowBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PotomacDarkGrayBrush}"/>
        <Setter Property="Padding" Value="24,11"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="40"/>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource RajdhaniBold}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PotomacYellowBrush}"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderBrush" Value="{StaticResource PotomacYellowBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="38"/>
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource RajdhaniBold}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PotomacPinkBrush}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderBrush" Value="{StaticResource PotomacPinkBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="34"/>
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource QuicksandMedium}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="8,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource RajdhaniBold}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <!-- ================================================================
         INPUT STYLES
    ================================================================ -->
    <Style x:Key="InputStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource QuicksandRegular}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,11"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="MinHeight" Value="40"/>
    </Style>

    <Style x:Key="MultilineInputStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource QuicksandRegular}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,11"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="PasswordInputStyle" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource QuicksandRegular}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,11"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="MinHeight" Value="40"/>
    </Style>

    <Style x:Key="ComboInputStyle" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource QuicksandRegular}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="MinHeight" Value="40"/>
    </Style>

    <!-- ================================================================
         CARD / CONTAINER STYLES
    ================================================================ -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="24"/>
    </Style>

    <Style x:Key="CardSmallStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="StatCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="BadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#1AFEC00F"/>
        <Setter Property="BorderBrush" Value="#50FEC00F"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>

    <Style x:Key="DividerStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>

    <!-- ================================================================
         TAB BUTTON STYLES
    ================================================================ -->
    <Style x:Key="TabButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource RajdhaniBold}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <Style x:Key="TabButtonActiveStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource RajdhaniBold}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="CharacterSpacing" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource PotomacYellowBrush}"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="BorderBrush" Value="{StaticResource PotomacYellowBrush}"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>

    <!-- ================================================================
         LISTVIEW
    ================================================================ -->
    <Style x:Key="ConversationItemStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>


    <!-- ================================================================
         GHOST YELLOW — for inline text-links styled as buttons (e.g. "VIEW ALL")
    ================================================================ -->
    <Style x:Key="GhostYellowButtonStyle" TargetType="Button">
        <Setter Property="FontFamily"        Value="{StaticResource RajdhaniBold}"/>
        <Setter Property="FontSize"          Value="11"/>
        <Setter Property="FontWeight"        Value="Bold"/>
        <Setter Property="CharacterSpacing"  Value="40"/>
        <Setter Property="Background"        Value="Transparent"/>
        <Setter Property="Foreground"        Value="{StaticResource PotomacYellowBrush}"/>
        <Setter Property="BorderThickness"   Value="0"/>
        <Setter Property="Padding"           Value="0"/>
        <Setter Property="CornerRadius"      Value="4"/>
    </Style>

    <!-- ================================================================
         QUICK TOOL BUTTON — card-style buttons used in the Quick Tools panel
    ================================================================ -->
    <Style x:Key="QuickToolButtonStyle" TargetType="Button">
        <Setter Property="HorizontalAlignment"        Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Background"                 Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush"                Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness"            Value="1"/>
        <Setter Property="CornerRadius"               Value="10"/>
        <Setter Property="Padding"                    Value="14,12"/>
    </Style>

</ResourceDictionary>
